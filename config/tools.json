{
  "tools": {
    "etsy_listings": {
      "enabled": true,
      "description": "Search active Etsy listings for a keyword: competition, prices, views, favorites, listing age.",
      "capability": "research_marketplace",
      "cost_per_call_eur": 0,
      "max_calls_per_day": 100,
      "allowed_hosts": ["openapi.etsy.com"],
      "api_key_env": "ETSY_API_KEY"
    },
    "web_research": {
      "enabled": true,
      "description": "Search the web (goal + 1-3 queries), read the top public pages and write a report whose findings cite their sources.",
      "capability": "web_research",
      "cost_per_call_eur": 0,
      "max_calls_per_day": 60,
      "allowed_hosts": ["api.tavily.com", "api.search.brave.com", "html.duckduckgo.com", "lite.duckduckgo.com", "127.0.0.1", "localhost"],
      "settings": {
        "provider": "auto",
        "auto_order": ["tavily", "brave", "searxng", "duckduckgo"],
        "searxng_url": "",
        "duckduckgo_enabled": true,
        "region": "us-en",
        "results_per_query": 8,
        "respect_robots": true,
        "cost_per_search_eur": {"tavily": 0.0, "brave": 0.005, "searxng": 0.0, "duckduckgo": 0.0}
      }
    },
    "product_builder": {
      "enabled": true,
      "description": "Build a finished digital product from a brief (type, title, audience, pages, theme): print-ready A4 + US Letter PDFs, page previews, mockups, marketplace listing and a download zip.",
      "capability": "create_digital_product",
      "cost_per_call_eur": 0,
      "max_calls_per_day": 10,
      "allowed_hosts": [],
      "settings": {"formats": ["A4", "Letter"], "preview_pages": 6, "write_listing": true, "max_content_pages": 12}
    },
    "image_studio": {
      "enabled": true,
      "description": "Marketing images in platform sizes: product images, headline and quote cards, and AI photos (local Stable Diffusion first, then paid APIs if keys are set).",
      "capability": "create_graphics",
      "cost_per_call_eur": 0,
      "max_calls_per_day": 100,
      "allowed_hosts": ["api.openai.com", "gen.pollinations.ai", "127.0.0.1", "localhost"],
      "settings": {
        "provider_order": ["sdcpp", "a1111", "openai", "pollinations"],
        "style_suffix": "professional photography, natural light, high detail",
        "sdcpp": {
          "enabled": true,
          "exe": "tools/sdcpp/sd-cli.exe",
          "model": "models/image/sdxl_lightning_4step.q4_0.gguf",
          "steps": 4,
          "cfg_scale": 1.0,
          "sampling_method": "euler",
          "scheduler": "sgm_uniform",
          "flags": ["--vae-tiling"],
          "node": "main-pc",
          "cost_per_image_eur": 0
        },
        "a1111": {"enabled": false, "base_url": "http://127.0.0.1:7860", "node": "main-pc"},
        "openai": {"enabled": false, "base_url": "https://api.openai.com/v1", "model": "gpt-image-1", "api_key_env": "OPENAI_API_KEY", "sizes": [[1024, 1024], [1024, 1536], [1536, 1024]], "quality": "medium", "cost_per_image_eur": 0.05},
        "pollinations": {"enabled": false, "base_url": "https://gen.pollinations.ai/v1", "model": "flux", "api_key_env": "POLLINATIONS_API_KEY", "sizes": [[1024, 1024], [832, 1216], [1216, 832]], "cost_per_image_eur": 0.01}
      }
    },
    "video_studio": {
      "enabled": true,
      "description": "Short marketing video from a storyboard (2-8 scenes with captions and narration): product visuals or AI photos, voiceover, end card; MP4 + subtitles.",
      "capability": "create_video",
      "cost_per_call_eur": 0,
      "max_calls_per_day": 20,
      "allowed_hosts": ["api.elevenlabs.io"],
      "settings": {
        "fps": 30,
        "max_total_seconds": 60,
        "voice": {"engine": "piper", "piper_voice": "models/voices/en_US-lessac-medium.onnx"}
      }
    },
    "campaign_builder": {
      "enabled": true,
      "description": "Build a campaign pack from a brief (goal, audience, message, offer, channels, days): strategy, dated posts with images/videos, email sequence, blog article, calendar CSV and zip.",
      "capability": "create_campaign",
      "cost_per_call_eur": 0,
      "max_calls_per_day": 5,
      "allowed_hosts": [],
      "settings": {"start_offset_days": 1, "max_ai_photos": 6}
    }
  }
}
